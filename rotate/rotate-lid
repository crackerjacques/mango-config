#!/bin/bash
# RG Rotate: lid switch handler, run by the switchbind lines in bind.conf.

OUTPUT=DSI-1
CONF=${XDG_CONFIG_HOME:-$HOME/.config}
EXAMPLE=$CONF/rotate-lid.d/lid_example
# the script picked in Lid Settings, or the example
SCRIPT=$(cat "$CONF/rotate-lid.script" 2>/dev/null)
SCRIPT=${SCRIPT:-$EXAMPLE}
if [ "$SCRIPT" = "$EXAMPLE" ] && [ ! -e "$EXAMPLE" ]; then
	install -D -m 755 /usr/share/rotate-lid/lid_example "$EXAMPLE" 2>/dev/null
fi

mode=$(cat "$CONF/rotate-lid" 2>/dev/null)

if [ "$mode" = script ]; then
	if [ -x "$SCRIPT" ]; then
		exec "$SCRIPT" "$1"
	fi
	notify-send -a Lid "Lid script missing or not executable: $SCRIPT" 2>/dev/null
	mmsg dispatch "wakeup_monitor,$OUTPUT"
	exit 1
fi

case "$1:${mode:-none}" in
	fold:off)	mmsg dispatch "sleep_monitor,$OUTPUT" ;;
	fold:sleep)	systemctl suspend ;;
	unfold:*)	mmsg dispatch "wakeup_monitor,$OUTPUT" ;;
esac

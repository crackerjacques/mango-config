    ("cpu", "CPU", False, 60),
    ("memory", "Memory", False, 60),
    ("custom/temp", "Temperature", False, 55),
    ("custom/watt", "Power draw", False, 60),
    ("custom/wifi", "Wi-Fi", False, 55),
    ("custom/disk", "Free disk", False, 60),
    ("custom/uptime", "Uptime", False, 70),
    ("custom/load", "Load", False, 50),
    ("hideclients", "Hidden windows", False, 40),
    ("clock#date", "Date", False, 55),
    ("clock#time", "Time", False, 55),
    ("custom/power", "Power menu", False, 30),

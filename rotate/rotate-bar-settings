SENSORS = {
    "custom/temp": ("temp", 10, " {}"),
    "custom/watt": ("watt", 5, "\U000f140b {}"),
    "custom/wifi": ("wifi", 10, "\U000f05a9 {}"),
    "custom/disk": ("disk", 60, "\U000f02ca {}"),
    "custom/uptime": ("uptime", 60, "\U000f0150 {}"),
    "custom/load": ("load", 10, "\U000f061a {}"),
}

CORNERS = [("round", "Round", 100), ("rounded", "Slightly round", 8), ("square", "Square", 0)]
FILLS = [("gradient", "Gradient"), ("flat", "Flat")]
SIZES = [("small", "Small", 14, 6, 26), ("medium", "Medium", 17, 8, 30),
         ("large", "Large", 20, 10, 34)]

PILLS = [
    ("#tags", "tag", "text"), ("#tags:hover", "accent4", "ink"),
    ("#tags.active", "active", "ink"), ("#tags.occupied", "tag", "text"),
    ("#tags.urgent", "urgent", "ink"), ("#tags.empty", "tag", "text"),
    ("#overview", "active", "ink"), ("#layout", "accent4", "ink"),
    ("#title", "accent4", "ink"), ("#clock", "accent3", "ink"),

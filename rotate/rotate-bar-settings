DEFAULTS = {
    "theme": "gruvbox",
    "colors": {},
    "corners": "round", "fill": "gradient", "size": "small",
    "upper": {"on": True, "modules": ["workspaces", "window", "tray", "pulseaudio", "battery",
                                      "clock#date", "clock#time", "custom/power"]},
}

APP_CSS = """
window { background: #201b14; }
label { color: #d1b88e; font-family: Hack; font-size: 15px; }
label.head { color: #ac9259; font-weight: bold; }
label.warn { color: #ef2929; }

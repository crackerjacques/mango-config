    ("menu", "Menu background"),
]

# (key, title, outputs, width in px - 0 when unknown)
BARS = [("upper", "Bar", ["DSI-1"], 720)]

MODULES = [
    ("workspaces", "Tags", True, 80),
    ("layout", "Layout", True, 40),
    ("window", "Window title", True, 0),

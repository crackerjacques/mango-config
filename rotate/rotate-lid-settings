#!/usr/bin/env python3
# RG Rotate: choose what closing the lid does.

import os
import subprocess

import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gdk, GLib, Gtk

CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                    "rotate-lid")
DROPIN = "/etc/systemd/logind.conf.d/50-rotate-lid.conf"
SETUP = ("mkdir -p /etc/systemd/logind.conf.d && "
         "printf '[Login]\\nHandleLidSwitch=ignore\\nHandleLidSwitchExternalPower=ignore\\n"
         "HandleLidSwitchDocked=ignore\\n' >" + DROPIN + " && "
         "systemctl reload systemd-logind")

MODES = [("none", "Do nothing"), ("off", "Screen off"), ("sleep", "Sleep"),
         ("script", "Run script")]

# "Run script": rotate-lid runs this with "fold" or "unfold". Any language
# works as long as it is executable and starts with a #! line.
SCRIPT = os.path.join(os.path.dirname(CONF), "rotate-lid.d", "lid")
TEMPLATE = """#!/bin/sh
# RG Rotate: run when the lid closes (fold) and opens (unfold), when Lid
# Settings is on "Run script". Opening is up to this script as well, so
# wake the screen in "unfold".
#
# Python works too: make the first line #!/usr/bin/env python3 and read
# sys.argv[1]. Keep the file executable (chmod +x).

case "$1" in
fold)
	# a stand-by screen instead of a dark one, for example:
	# foot --fullscreen -e tty-clock -c &
	mmsg dispatch sleep_monitor,DSI-1
	;;
unfold)
	# pkill -f tty-clock
	mmsg dispatch wakeup_monitor,DSI-1
	;;
esac
"""

CSS = """
window { background: #201b14; }
label { color: #d1b88e; font-family: Hack; font-size: 28px; }
label.dim { color: #888888; }
label.err { color: #ef2929; }
label.small { font-size: 16px; }
button {
    background: #201b14; background-image: none; box-shadow: none;
    border: 4px solid #201b14; border-radius: 10px; padding: 16px;
}
button:checked { background: #ac9259; }
button:checked label { color: #201b14; }
button:focus { border-color: #d1b88e; }
"""


def current():
    try:
        with open(CONF) as f:
            mode = f.read().strip()
    except OSError:
        mode = ""
    return mode if mode in dict(MODES) else "none"


def load_css():
    provider = Gtk.CssProvider()
    if hasattr(provider, "load_from_string"):
        provider.load_from_string(CSS)
    else:
        provider.load_from_data(CSS, -1)
    Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                              Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


class LidSettings(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Lid Settings")

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                      margin_top=24, margin_bottom=24, margin_start=24, margin_end=24)
        self.set_child(box)

        head = Gtk.Label(label="When the lid closes", xalign=0)
        head.add_css_class("dim")
        box.append(head)

        cur = current()
        group = None
        focus = None
        for mode, label in MODES:
            b = Gtk.ToggleButton(label=label)
            if group:
                b.set_group(group)
            group = group or b
            b.set_active(mode == cur)
            b.connect("toggled", self.on_toggled, mode)
            box.append(b)
            if mode == cur:
                focus = b

        self.script_row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                                  visible=cur == "script")
        path = Gtk.Label(label=SCRIPT.replace(os.path.expanduser("~"), "~", 1),
                         xalign=0, wrap=True)
        path.add_css_class("dim")
        path.add_css_class("small")
        self.script_row.append(path)
        edit = Gtk.Button(label="Edit script")
        edit.connect("clicked", self.on_edit)
        self.script_row.append(edit)
        box.append(self.script_row)

        self.status = Gtk.Label(xalign=0, wrap=True)
        box.append(self.status)

        self.present()
        focus.grab_focus()

    def on_key(self, _ctl, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def on_toggled(self, button, mode):
        if not button.get_active():
            return
        os.makedirs(os.path.dirname(CONF), exist_ok=True)
        with open(CONF, "w") as f:
            f.write(mode + "\n")
        self.script_row.set_visible(mode == "script")
        if mode == "script" and not os.path.exists(SCRIPT):
            os.makedirs(os.path.dirname(SCRIPT), exist_ok=True)
            with open(SCRIPT, "w") as f:
                f.write(TEMPLATE)
            os.chmod(SCRIPT, 0o755)
        self.label = dict(MODES)[mode]
        if os.path.exists(DROPIN):
            self.report()
            return
        self.say(f"Saved: {self.label}\nSetting up logind…")
        p = subprocess.Popen(["foot", "-e", "sudo", "sh", "-c", SETUP])
        GLib.child_watch_add(GLib.PRIORITY_DEFAULT, p.pid, lambda *a: self.report())

    def on_edit(self, _button):
        subprocess.Popen(["foot", "-e", "sh", "-c", '${EDITOR:-nano} "$1"', "sh", SCRIPT],
                         start_new_session=True)

    def report(self):
        if os.path.exists(DROPIN):
            self.say(f"Saved: {self.label}")
        else:
            self.say(f"Saved: {self.label}\nlogind still handles the lid (setup not done)", "err")

    def say(self, text, cls=None):
        self.status.remove_css_class("err")
        if cls:
            self.status.add_css_class(cls)
        self.status.set_text(text)


def on_activate(app):
    load_css()
    LidSettings(app)


app = Gtk.Application(application_id="org.armbian.RotateLidSettings")
app.connect("activate", on_activate)
app.run(None)

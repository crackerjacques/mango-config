#!/usr/bin/env python3
# RG Rotate: choose what closing the lid does.

import os
import shutil
import stat
import subprocess

import gi
gi.require_version("Gtk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk

CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                    "rotate-lid")
DROPIN = "/etc/systemd/logind.conf.d/50-rotate-lid.conf"
SETUP = ("mkdir -p /etc/systemd/logind.conf.d && "
         "printf '[Login]\\nHandleLidSwitch=ignore\\nHandleLidSwitchExternalPower=ignore\\n"
         "HandleLidSwitchDocked=ignore\\n' >" + DROPIN + " && "
         "systemctl reload systemd-logind")

MODES = [("none", "Do nothing"), ("off", "Screen off"), ("sleep", "Sleep"),
         ("script", "Run script")]

# "Run script": rotate-lid runs the picked script with "fold" or "unfold";
# anything executable with a #! line.
SCRIPT_DIR = os.path.join(os.path.dirname(CONF), "rotate-lid.d")
PICK = CONF + ".script"
EXAMPLE = os.path.join(SCRIPT_DIR, "lid_example")
EXAMPLE_SRC = "/usr/share/rotate-lid/lid_example"

def script():
    try:
        with open(PICK) as f:
            path = f.read().strip()
    except OSError:
        path = ""
    return path or EXAMPLE

def short(path):
    return path.replace(os.path.expanduser("~"), "~", 1)

CSS = """
window { background: #201b14; }
label { color: #d1b88e; font-family: Hack; font-size: 18px; }
label.dim { color: #888888; }
label.err { color: #ef2929; }
label.small { font-size: 13px; }
button {
    background: #201b14; background-image: none; box-shadow: none;
    border: 3px solid #201b14; border-radius: 8px; padding: 8px;
}
button:checked { background: #ac9259; }
button:checked label { color: #201b14; }
button:focus { border-color: #d1b88e; }
"""

def current():
    try:
        with open(CONF) as f:
            mode = f.read().strip()
    except OSError:
        mode = ""
    return mode if mode in dict(MODES) else "none"


def load_css():
    provider = Gtk.CssProvider()
    if hasattr(provider, "load_from_string"):
        provider.load_from_string(CSS)
    else:
        provider.load_from_data(CSS, -1)
    Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                              Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

class LidSettings(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Lid Settings")

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                      margin_top=14, margin_bottom=14, margin_start=16, margin_end=16)
        self.set_child(box)

        head = Gtk.Label(label="When the lid closes", xalign=0)
        head.add_css_class("dim")
        box.append(head)

        cur = current()
        group = None
        focus = None
        for mode, label in MODES:
            b = Gtk.ToggleButton(label=label)
            if group:
                b.set_group(group)
            group = group or b
            b.set_active(mode == cur)
            b.connect("toggled", self.on_toggled, mode)
            box.append(b)
            if mode == cur:
                focus = b

        self.script_row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                                  visible=cur == "script")
        self.path = Gtk.Label(label=short(script()), xalign=0, wrap=True)
        self.path.add_css_class("dim")
        self.path.add_css_class("small")
        self.script_row.append(self.path)
        row = Gtk.Box(spacing=8, homogeneous=True)
        choose = Gtk.Button(label="Choose…")
        choose.connect("clicked", self.on_choose)
        edit = Gtk.Button(label="Edit")
        edit.connect("clicked", self.on_edit)
        row.append(choose)
        row.append(edit)
        self.script_row.append(row)
        box.append(self.script_row)

        self.status = Gtk.Label(xalign=0, wrap=True)
        box.append(self.status)

        self.present()
        focus.grab_focus()

    def on_key(self, _ctl, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def on_toggled(self, button, mode):
        if not button.get_active():
            return
        os.makedirs(os.path.dirname(CONF), exist_ok=True)
        with open(CONF, "w") as f:
            f.write(mode + "\n")
        self.script_row.set_visible(mode == "script")
        if mode == "script" and script() == EXAMPLE and not os.path.exists(EXAMPLE):
            os.makedirs(SCRIPT_DIR, exist_ok=True)
            try:
                shutil.copy(EXAMPLE_SRC, EXAMPLE)
                os.chmod(EXAMPLE, 0o755)
            except OSError:
                pass
        self.label = dict(MODES)[mode]
        if os.path.exists(DROPIN):
            self.report()
            return
        self.say(f"Saved: {self.label}\nSetting up logind…")
        p = subprocess.Popen(["foot", "-e", "sudo", "sh", "-c", SETUP])
        GLib.child_watch_add(GLib.PRIORITY_DEFAULT, p.pid, lambda *a: self.report())

    def on_choose(self, _button):
        os.makedirs(SCRIPT_DIR, exist_ok=True)
        dialog = Gtk.FileDialog(title="Lid script")
        dialog.set_initial_folder(Gio.File.new_for_path(SCRIPT_DIR))
        dialog.open(self, None, self.chosen)

    def chosen(self, dialog, result):
        try:
            path = dialog.open_finish(result).get_path()
        except GLib.Error:  # cancelled
            return
        with open(PICK, "w") as f:
            f.write(path + "\n")
        self.path.set_text(short(path))
        note = ""
        if not os.access(path, os.X_OK):
            try:
                os.chmod(path, os.stat(path).st_mode | stat.S_IXUSR)
                note = " (made executable)"
            except OSError:
                self.say(f"Picked {short(path)}, but it is not executable", "err")
                return
        self.say(f"Script: {short(path)}{note}")

    def on_edit(self, _button):
        subprocess.Popen(["foot", "-e", "sh", "-c", '${EDITOR:-nano} "$1"', "sh", script()],
                         start_new_session=True)

    def report(self):
        if os.path.exists(DROPIN):
            self.say(f"Saved: {self.label}")
        else:
            self.say(f"Saved: {self.label}\nlogind still handles the lid (setup not done)", "err")

    def say(self, text, cls=None):
        self.status.remove_css_class("err")
        if cls:
            self.status.add_css_class(cls)
        self.status.set_text(text)


def on_activate(app):
    load_css()
    LidSettings(app)

app = Gtk.Application(application_id="org.armbian.RotateLidSettings")
app.connect("activate", on_activate)
app.run(None)

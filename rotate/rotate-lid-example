#!/usr/bin/env python3

import os
import signal
import subprocess
import sys

OUTPUT = "DSI-1"
TEXT = "THIS IS SCRIPT EXAMPLE SCREEN"
PIDFILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "rotate-lid-example.pid")


def running_pid():
    try:
        pid = int(open(PIDFILE).read())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def fold():
    # the screen runs on its own, so rotate-lid is not kept waiting
    if not running_pid():
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "show"],
                         start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def unfold():
    pid = running_pid()
    if pid:
        os.kill(pid, signal.SIGTERM)
    subprocess.run(["mmsg", "dispatch", f"wakeup_monitor,{OUTPUT}"])


def show():
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gdk, GLib, Gtk

    css = Gtk.CssProvider()
    style = """
    window { background: #000000; }
    label { color: #ac9259; font-family: Hack; font-size: 40px; font-weight: bold; }
    label.off { color: #000000; }
    """
    if hasattr(css, "load_from_string"):
        css.load_from_string(style)
    else:
        css.load_from_data(style, -1)

    def activate(app):
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win = Gtk.ApplicationWindow(application=app, title="Lid example")
        label = Gtk.Label(label=TEXT, wrap=True, justify=Gtk.Justification.CENTER)
        win.set_child(label)

        def blink():
            if label.has_css_class("off"):
                label.remove_css_class("off")
            else:
                label.add_css_class("off")
            return True
        GLib.timeout_add(500, blink)

        # any key, button or touch ends it
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", lambda *_: app.quit())
        win.add_controller(keys)
        click = Gtk.GestureClick()
        click.connect("pressed", lambda *_: app.quit())
        win.add_controller(click)

        win.fullscreen()
        win.present()

    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))
    app = Gtk.Application(application_id="org.armbian.RotateLidExample")
    app.connect("activate", activate)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda: app.quit() or False)
    try:
        app.run(None)
    finally:
        try:
            os.remove(PIDFILE)
        except OSError:
            pass


cmd = sys.argv[1] if len(sys.argv) > 1 else ""
if cmd == "fold":
    fold()
elif cmd == "unfold":
    unfold()
elif cmd == "show":
    show()
else:
    print("usage: lid_example fold | unfold | show", file=sys.stderr)
    sys.exit(1)

#!/bin/sh
# RG Rotate: (re)start mangobar. Uses what rotate-bar-settings wrote to
# ~/.config/rotate-bar, or the stock config in the mango config until then.
#   rotate-bar           restart it
#   rotate-bar --toggle  stop it if it runs, start it if not (Super+h)
u=${XDG_CONFIG_HOME:-$HOME/.config}/rotate-bar
m=$HOME/.config/mango/mangobar
cfg=$m/config.jsonc
css=$m/style.css
[ -f "$u/config.jsonc" ] && cfg=$u/config.jsonc
[ -f "$u/style.css" ] && css=$u/style.css

if pkill -x mangobar && [ "$1" = --toggle ]; then
	exit 0
fi
exec mangobar -c "$cfg" -s "$css"

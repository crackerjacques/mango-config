#!/usr/bin/env python3
# RG DS: the sticks as a mouse - one moves the pointer, the other scrolls,
# their clicks are left / right (the pointer stick's is left).

import json
import math
import os
import select
import time

import evdev
from evdev import ecodes as e, UInput

NAME = "rgds-stick"
CONF = "/etc/rgds-stick.json"
DEFAULTS = {
    "enabled": True,
    "swap": False,
    "speed": 1200,
    "scroll": 25,
    "horizontal": True,
    "deadzone": 0.12,
}
TICK = 0.01
LEFT_STICK, RIGHT_STICK = (e.ABS_X, e.ABS_Y), (e.ABS_RX, e.ABS_RY)
AXES = LEFT_STICK + RIGHT_STICK
FLIP = {e.ABS_Y, e.ABS_RY}

class Settings:
    def __init__(self):
        self.mtime = None
        self.s = dict(DEFAULTS)

    def poll(self):
        """Reload when the file changed; a half-written file keeps the old."""
        try:
            mtime = os.stat(CONF).st_mtime
        except OSError:
            mtime = None
        if mtime == self.mtime:
            return
        self.mtime = mtime
        try:
            with open(CONF) as f:
                s = {**DEFAULTS, **json.load(f)}
            for key, default in DEFAULTS.items():
                s[key] = type(default)(s[key])
        except (OSError, ValueError, TypeError):
            return
        self.s = s

    def __getitem__(self, key):
        return self.s[key]


def find():
    """The stick device (all four axes, no buttons, so not a USB pad) and
    the one carrying the stick clicks."""
    stick = buttons = None
    for path in evdev.list_devices():
        try:
            d = evdev.InputDevice(path)
        except OSError:
            continue
        caps = d.capabilities()
        axes = {a[0] if isinstance(a, tuple) else a for a in caps.get(e.EV_ABS, [])}
        keys = set(caps.get(e.EV_KEY, []))
        clicks = {e.BTN_THUMBL, e.BTN_THUMBR}
        if d.name != NAME and not stick and set(AXES) <= axes and not keys:
            stick = d
        elif d.name != NAME and not buttons and clicks & keys and not axes:
            buttons = d
        else:
            d.close()
    return stick, buttons


def curve(x, dz):
    """Dead zone, then squared so small tilts are fine-grained."""
    a = abs(x)
    if a < dz:
        return 0.0
    t = min(1.0, (a - dz) / (1 - dz))
    return math.copysign(t * t, x)


ui = UInput({e.EV_REL: [e.REL_X, e.REL_Y, e.REL_WHEEL, e.REL_HWHEEL,
                        e.REL_WHEEL_HI_RES, e.REL_HWHEEL_HI_RES],
             e.EV_KEY: [e.BTN_LEFT, e.BTN_RIGHT]}, name=NAME)

settings = Settings()
stick = buttons = None
centre, half = {}, {}
pos = {a: 0.0 for a in AXES}     # -1 .. 1
rest = {e.REL_X: 0.0, e.REL_Y: 0.0, e.REL_WHEEL_HI_RES: 0.0, e.REL_HWHEEL_HI_RES: 0.0}
notch = {e.REL_WHEEL_HI_RES: 0, e.REL_HWHEEL_HI_RES: 0}
last = time.monotonic()

while True:
    if not stick:
        stick, buttons = find()
        if not stick:
            time.sleep(2)
            continue
        for a in AXES:
            info = stick.absinfo(a)
            centre[a] = (info.min + info.max) / 2
            half[a] = (info.max - info.min) / 2 or 1
            pos[a] = 0.0

    settings.poll()
    on, dz = settings["enabled"], settings["deadzone"]
    point, scroll = (RIGHT_STICK, LEFT_STICK) if settings["swap"] else (LEFT_STICK, RIGHT_STICK)
    click = ({e.BTN_THUMBR: e.BTN_LEFT, e.BTN_THUMBL: e.BTN_RIGHT} if settings["swap"]
             else {e.BTN_THUMBL: e.BTN_LEFT, e.BTN_THUMBR: e.BTN_RIGHT})

    moving = on and any(curve(pos[a], dz) for a in AXES)
    fds = [d for d in (stick, buttons) if d]
    r, _, _ = select.select(fds, [], [], TICK if moving else None)
    try:
        for d in r:
            for ev in d.read():
                if ev.type == e.EV_ABS and ev.code in pos:
                    v = (ev.value - centre[ev.code]) / half[ev.code]
                    if ev.code in FLIP:
                        v = -v
                    pos[ev.code] = max(-1.0, min(1.0, v))

                elif (ev.type == e.EV_KEY and ev.code in click
                      and (ev.value == 0 or (on and ev.value == 1))):
                    ui.write(e.EV_KEY, click[ev.code], ev.value)
                    ui.syn()
    except OSError:
        stick = buttons = None
        continue

    now = time.monotonic()
    dt, last = min(now - last, 0.05), now
    if not moving:
        continue
    speed, notches = settings["speed"], settings["scroll"]
    rest[e.REL_X] += curve(pos[point[0]], dz) * speed * dt
    rest[e.REL_Y] += curve(pos[point[1]], dz) * speed * dt
    rest[e.REL_WHEEL_HI_RES] -= curve(pos[scroll[1]], dz) * notches * 120 * dt
    if settings["horizontal"]:
        rest[e.REL_HWHEEL_HI_RES] += curve(pos[scroll[0]], dz) * notches * 120 * dt
    sent = False
    for code, value in rest.items():
        step = int(value)
        if not step:
            continue
        rest[code] -= step
        ui.write(e.EV_REL, code, step)
        sent = True
        if code in notch:
            notch[code] += step
            whole = int(notch[code] / 120)
            if whole:
                notch[code] -= whole * 120
                ui.write(e.EV_REL, e.REL_WHEEL if code == e.REL_WHEEL_HI_RES else e.REL_HWHEEL,
                         whole)
    if sent:
        ui.syn()

#!/usr/bin/env python3
# RG DS: republish the two Goodix touchscreens under distinct names.
#
# Both panels report the same name and IDs, and mango's devicerule can only
# match on those, so it cannot pin each one to its own screen. This grabs each
# panel - picked by i2c controller, as rgds-screen does on X11 - and replays
# it through a uinput device with its own name; config.conf then pins
# rgds-touch-top to DSI-2 and rgds-touch-bottom to DSI-1.
#
# The grab hides the real panels from everything else, so this is for the
# mango session only: autostart.sh starts it and logout stops it, and under
# X11 rgds-screen maps the real devices instead.
import glob, os, select, time, evdev
from evdev import UInput

PANELS = {"fe5c0000": "rgds-touch-top", "fe5e0000": "rgds-touch-bottom"}


def open_panels(skip):
    out = {}
    for ctl, name in PANELS.items():
        if name in skip:
            continue
        for path in glob.glob(f"/dev/input/by-path/platform-{ctl}.i2c*-event"):
            try:
                dev = evdev.InputDevice(os.path.realpath(path))
            except OSError:
                continue
            try:
                dev.grab()
            except OSError:
                dev.close()
                continue
            ui = UInput.from_device(dev, name=name, input_props=dev.input_props())
            out[dev.fd] = (dev, ui)
    return out


def close(pair):
    dev, ui = pair
    for f in (dev.ungrab, dev.close, ui.close):
        try: f()
        except Exception: pass


# Run with whichever panels are there and keep looking for a missing one, so
# a panel that fails to probe does not take the other one down with it.
panels = {}
while True:
    missing = len(panels) < len(PANELS)
    if missing:
        panels.update(open_panels({ui.name for _, ui in panels.values()}))
    if not panels:
        time.sleep(2)
        continue
    r, _, _ = select.select(panels, [], [], 2 if missing else None)
    for fd in r:
        dev, ui = panels[fd]
        try:
            for ev in dev.read():
                ui.write_event(ev)
        except OSError:
            close(panels.pop(fd))

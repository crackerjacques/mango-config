#!/bin/sh
# RG DS: screenshot of every screen, and recording of the focused one.

conf=${XDG_CONFIG_HOME:-$HOME/.config}/rgds-capture
last=${XDG_RUNTIME_DIR:-/tmp}/rgds-capture
stamp=$(date +%Y%m%d-%H%M%S)

say() {
	notify-send -a Capture -t 3000 "$1" 2>/dev/null || echo "$1"
}

sound=$(cat "$conf" 2>/dev/null)
sound=${sound:-system}

case "$1" in
shot)
	dir=$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots
	mkdir -p "$dir"
	grim "$dir/screenshot-$stamp.png" && say "Screenshot: $dir/screenshot-$stamp.png"
	;;
record)
	if pkill -INT -x wf-recorder; then
		say "Recording saved: $(cat "$last" 2>/dev/null)"
		exit 0
	fi
	dir=$(xdg-user-dir VIDEOS 2>/dev/null || echo "$HOME/Videos")
	mkdir -p "$dir"
	file=$dir/recording-$stamp.mp4
	case "$sound" in
		system) set -- "--audio=$(pactl get-default-sink).monitor" ;;
		mic) set -- --audio ;;
		*) set -- ;;
	esac
	# with more than one screen wf-recorder stops to ask which, so name the
	# focused one
	out=$(mmsg get all-monitors 2>/dev/null | python3 -c '
import json, sys
print(next(m["name"] for m in json.load(sys.stdin)["monitors"] if m.get("active")))' 2>/dev/null)
	[ -n "$out" ] && set -- "$@" -o "$out"
	echo "$file" >"$last"
	wf-recorder "$@" -c libx264 -p preset=ultrafast -p crf=28 -x yuv420p -r 30 \
		-f "$file" </dev/null >/dev/null 2>&1 &
	say "Recording, sound: $sound. SELECT + R1 again to stop."
	;;
sound)
	case "$sound" in
		system) sound=mic ;;
		mic) sound=off ;;
		*) sound=system ;;
	esac
	mkdir -p "${conf%/*}"
	echo "$sound" >"$conf"
	say "Recording sound: $sound"
	;;
*)
	echo "usage: rgds-capture shot | record | sound" >&2
	exit 1
	;;
esac

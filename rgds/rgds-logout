#!/bin/sh
# RG DS: logout menu laid out for a 640x480 panel. Run by the power key
# (bind.conf) and the mangobar power icon; running it again closes the menu.
pkill -x wlogout && exit 0
exec wlogout -C ~/.config/mango/wlogout/style.css -l ~/.config/mango/wlogout/layout \
	-b 1 -T 92 -B 112 -L 160 -R 120 -r 12 --protocol layer-shell

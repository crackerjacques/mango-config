#!/bin/sh
# RG DS: blank both panels until the next button press or touch.
flag=${XDG_RUNTIME_DIR:-/tmp}/rgds-screenoff

if [ "$1" = wake ]; then
	for o in DSI-1 DSI-2; do mmsg dispatch "wakeup_monitor,$o"; done
	[ -s "$flag" ] && kill "$(cat "$flag")" 2>/dev/null

	(sleep 1; rm -f "$flag") &
	exit 0
fi

[ -e "$flag" ] && exit 0
echo $$ >"$flag"
for o in DSI-1 DSI-2; do mmsg dispatch "sleep_monitor,$o"; done
exec swayidle timeout 1 true resume "rgds-screenoff wake"

#!/usr/bin/env python3
# RG DS: gamepad/HOME buttons -> keyboard keys (evdev/uinput).

import glob, os, pwd, select, subprocess, time, evdev
from evdev import ecodes as e, UInput


MAP = {
    e.BTN_DPAD_UP: e.KEY_UP,     e.BTN_DPAD_DOWN: e.KEY_DOWN,
    e.BTN_DPAD_LEFT: e.KEY_LEFT, e.BTN_DPAD_RIGHT: e.KEY_RIGHT,
    e.BTN_SOUTH:  e.KEY_ENTER,
    e.BTN_EAST:   e.KEY_ESC,
    e.BTN_WEST:   e.KEY_BACKSPACE,
    e.BTN_START:  e.KEY_LEFTMETA,
    e.BTN_SELECT: e.KEY_LEFTALT,
    e.KEY_HOME:   e.KEY_F13,
}

COMBO = {
    e.BTN_NORTH:  (e.KEY_LEFTCTRL,  e.KEY_F4),
    e.BTN_TR2:    (e.KEY_LEFTMETA,  e.KEY_F1),
    e.BTN_TL:     (e.KEY_LEFTMETA,  e.KEY_PAGEUP),
    e.BTN_TR:     (e.KEY_F14,),
}

HOLD = {
    e.BTN_TL2:    (e.KEY_LEFTMETA,  e.KEY_LEFTSHIFT),
}

HOME = e.BTN_MODE
HOME_TAP = (e.KEY_LEFTALT, e.KEY_TAB)
HOME_DPAD = {
    e.BTN_DPAD_LEFT:  (e.KEY_LEFTMETA, e.KEY_LEFTCTRL, e.KEY_LEFT),
    e.BTN_DPAD_RIGHT: (e.KEY_LEFTMETA, e.KEY_LEFTCTRL, e.KEY_RIGHT),
}

GAME = "/run/rgds-gamemode"
HOLD_BACK = 2.0
ALL = set(MAP) | set(COMBO) | set(HOLD) | {HOME}
PAD = {c for c in ALL if c != e.KEY_HOME}

def sources():
    out = {}
    for p in evdev.list_devices():
        try:
            d = evdev.InputDevice(p)
        except Exception:
            continue
        if d.name == "rgds-pad2key":
            continue
        caps = d.capabilities()
        if not PAD & set(caps.get(e.EV_KEY, [])):
            continue
        if caps.get(e.EV_ABS):
            continue
        out[d.fd] = d
    return out

devs = {}
while not devs:
    devs = sources()
    if not devs:
        time.sleep(2)

_keys = set(MAP.values())
for _seq in list(COMBO.values()) + list(HOLD.values()) + [HOME_TAP] + list(HOME_DPAD.values()):
    _keys.update(_seq)

ui = UInput({e.EV_KEY: sorted(_keys)}, name="rgds-pad2key")

held = {}

home_down = False
home_used = False
swallowed = set()

in_game = False
home_since = None


def game_mode():
    try:
        with open(GAME) as f:
            return f.read().strip() == "1"
    except OSError:
        return False


def set_game(on):
    with open(GAME, "w") as f:
        f.write("1\n" if on else "0\n")


def notify(msg):
    """This runs as root: reach the logged-in users' session buses."""
    for bus in glob.glob("/run/user/*/bus"):
        try:
            user = pwd.getpwuid(int(bus.split("/")[3])).pw_name
        except (KeyError, ValueError):
            continue
        subprocess.Popen(["runuser", "-u", user, "--", "env",
                          f"DBUS_SESSION_BUS_ADDRESS=unix:path={bus}",
                          "notify-send", "-a", "Game mode", "-t", "3000", msg],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def release_all():
    for keys in held.values():
        for k in keys:
            ui.write(e.EV_KEY, k, 0)
        keys.clear()
    ui.syn()


set_game(False)
os.chmod(GAME, 0o666)


def tap(seq):
    for k in seq: ui.write(e.EV_KEY, k, 1)
    for k in reversed(seq): ui.write(e.EV_KEY, k, 0)
    ui.syn()

def drop(fd):
    for k in held.pop(fd, ()):
        ui.write(e.EV_KEY, k, 0)
    ui.syn()
    try: devs[fd].close()
    except Exception: pass
    del devs[fd]

while True:
    if not devs:
        devs = sources()
        if not devs:
            time.sleep(2)
            continue
    timeout = None
    if home_since is not None:
        timeout = max(0.0, home_since + HOLD_BACK - time.monotonic())
    r, _, _ = select.select(devs, [], [], timeout)

    game = game_mode()
    if game != in_game:
        in_game = game
        if game:
            release_all()
            home_down, swallowed = False, set()
        home_since = None
    if in_game and home_since is not None and time.monotonic() - home_since >= HOLD_BACK:
        set_game(False)
        in_game, home_since = False, None
        # HOME is still down: its release must not switch windows
        home_down, home_used = True, True
        notify("Game mode off: the buttons and sticks drive the desktop again")
    for fd in r:
        try:
            events = list(devs[fd].read())
        except OSError:
            drop(fd)
            continue
        for ev in events:
            if ev.type != e.EV_KEY:
                continue
            if in_game:
                if ev.code == HOME and ev.value == 1:
                    home_since = time.monotonic()
                elif ev.code == HOME and ev.value == 0:
                    home_since = None
                continue
            if ev.code == HOME:
                if ev.value == 1:
                    home_down, home_used = True, False
                elif ev.value == 0:
                    home_down = False
                    if not home_used:
                        tap(HOME_TAP)
                continue
            if ev.code in HOME_DPAD:
                if ev.value == 1 and home_down:
                    home_used = True
                    swallowed.add(ev.code)
                    tap(HOME_DPAD[ev.code])
                    continue
                if ev.code in swallowed:
                    if ev.value == 0:
                        swallowed.discard(ev.code)
                    continue
            if ev.code in COMBO:
                if ev.value == 1:
                    tap(COMBO[ev.code])
            elif ev.code in HOLD:
                seq = HOLD[ev.code]
                if ev.value == 1:
                    held.setdefault(fd, set()).update(seq)
                    for k in seq: ui.write(e.EV_KEY, k, 1)
                elif ev.value == 0:
                    held.get(fd, set()).difference_update(seq)
                    for k in reversed(seq): ui.write(e.EV_KEY, k, 0)
                ui.syn()
            elif ev.code in MAP:
                k = MAP[ev.code]
                if ev.value == 1:
                    held.setdefault(fd, set()).add(k)
                elif ev.value == 0:
                    held.get(fd, set()).discard(k)
                ui.write(e.EV_KEY, k, ev.value)
                ui.syn()

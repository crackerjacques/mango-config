#!/usr/bin/env python3
# RG DS: gamepad/HOME buttons -> keyboard keys (evdev/uinput), mango variant of
# the bsp's /usr/bin/rgds-pad2key. install.sh puts it over that file and the
# existing rgds-pad2key.service runs it unchanged.
#  - L1/R1: Super+PageUp / Super+PageDown (wvkbd / foot in bind.conf)
#  - L2: held Super+Shift, so L2 + d-pad swaps the window with its neighbour
#    (exchange_client); R2: Super+F1 (rgds-cheatsheet in bind.conf)
#  - R3/L3: Tab / Shift+Tab
#  - SELECT: held Alt, so SELECT + d-pad moves focus to the next window, or
#    to the other screen when there is none that way (focusdir with
#    focus_cross_monitor); START + SELECT is screen off in bind.conf
#  - Y: Backspace
#  - the gpio HOME key (KEY_HOME): F13, input method on/off (bind.conf)

import time, select, evdev
from evdev import ecodes as e, UInput


MAP = {
    e.BTN_DPAD_UP: e.KEY_UP,     e.BTN_DPAD_DOWN: e.KEY_DOWN,
    e.BTN_DPAD_LEFT: e.KEY_LEFT, e.BTN_DPAD_RIGHT: e.KEY_RIGHT,
    e.BTN_SOUTH:  e.KEY_ENTER,
    e.BTN_EAST:   e.KEY_ESC,
    e.BTN_WEST:   e.KEY_BACKSPACE,
    e.BTN_START:  e.KEY_LEFTMETA,
    e.BTN_SELECT: e.KEY_LEFTALT,
    e.BTN_THUMBR: e.KEY_TAB,
    e.KEY_HOME:   e.KEY_F13,
}

COMBO = {
    e.BTN_MODE:   (e.KEY_LEFTALT,   e.KEY_TAB),
    e.BTN_NORTH:  (e.KEY_LEFTCTRL,  e.KEY_F4),
    e.BTN_THUMBL: (e.KEY_LEFTSHIFT, e.KEY_TAB),
    e.BTN_TR2:    (e.KEY_LEFTMETA,  e.KEY_F1),
    e.BTN_TL:     (e.KEY_LEFTMETA,  e.KEY_PAGEUP),
    e.BTN_TR:     (e.KEY_LEFTMETA,  e.KEY_PAGEDOWN),
}
# Held for as long as the button is: modifiers pressed in this order and
# released in reverse, so Super is never the last key down and letting go of
# the button is not taken for a bare Super tap (rofi).
HOLD = {
    e.BTN_TL2:    (e.KEY_LEFTMETA,  e.KEY_LEFTSHIFT),
}
ALL = set(MAP) | set(COMBO) | set(HOLD)
# Devices are picked by the gamepad buttons only: KEY_HOME is on the pad here,
# but also on every keyboard, whose Home key must stay a Home key.
PAD = {c for c in ALL if c != e.KEY_HOME}

# The buttons are split over two devices (gpio-keys pad, adc-keys HOME), so any
# device carrying a mapped code is taken. Anything with axes is skipped: that
# is a USB controller, whose buttons must not turn into desktop keys.
def sources():
    out = {}
    for p in evdev.list_devices():
        try:
            d = evdev.InputDevice(p)
        except Exception:
            continue
        if d.name == "rgds-pad2key":
            continue
        caps = d.capabilities()
        if not PAD & set(caps.get(e.EV_KEY, [])):
            continue
        if caps.get(e.EV_ABS):
            continue
        out[d.fd] = d
    return out

devs = {}
while not devs:
    devs = sources()
    if not devs:
        time.sleep(2)

_keys = set(MAP.values())
for _seq in list(COMBO.values()) + list(HOLD.values()):
    _keys.update(_seq)

ui = UInput({e.EV_KEY: sorted(_keys)}, name="rgds-pad2key")

# Keys this process is currently holding down, per source. A device can vanish
# mid-press, and without this the virtual keyboard keeps the key down for good.
held = {}

def tap(seq):
    for k in seq: ui.write(e.EV_KEY, k, 1)
    for k in reversed(seq): ui.write(e.EV_KEY, k, 0)
    ui.syn()

def drop(fd):
    for k in held.pop(fd, ()):
        ui.write(e.EV_KEY, k, 0)
    ui.syn()
    try: devs[fd].close()
    except Exception: pass
    del devs[fd]

while True:
    if not devs:
        devs = sources()
        if not devs:
            time.sleep(2)
            continue
    r, _, _ = select.select(devs, [], [])
    for fd in r:
        try:
            events = list(devs[fd].read())
        except OSError:
            drop(fd)
            continue
        for ev in events:
            if ev.type != e.EV_KEY:
                continue
            if ev.code in COMBO:
                if ev.value == 1:
                    tap(COMBO[ev.code])
            elif ev.code in HOLD:
                seq = HOLD[ev.code]
                if ev.value == 1:
                    held.setdefault(fd, set()).update(seq)
                    for k in seq: ui.write(e.EV_KEY, k, 1)
                elif ev.value == 0:
                    held.get(fd, set()).difference_update(seq)
                    for k in reversed(seq): ui.write(e.EV_KEY, k, 0)
                ui.syn()
            elif ev.code in MAP:
                k = MAP[ev.code]
                if ev.value == 1:
                    held.setdefault(fd, set()).add(k)
                elif ev.value == 0:
                    held.get(fd, set()).discard(k)
                ui.write(e.EV_KEY, k, ev.value)
                ui.syn()
